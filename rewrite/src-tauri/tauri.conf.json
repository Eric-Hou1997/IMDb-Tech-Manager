{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ITM Validation",
  "version": "4.1.0",
  "identifier": "io.github.eric-hou1997.itm.validation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ITM 技术验证",
        "width": 1000,
        "height": 760,
        "minWidth": 420,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libdbus-1-3"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "dbus-libs"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "quiet"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IEV4aXN0aW5nIElUTSBFZDI1NTE5IHB1YmxpYyBrZXkKUldTMWhERHdaQ0JwaUZJbTNrZlNzQndVRE5NZmRhaThjK3VCdENKNDA5cWRLL2ZXdk40Uzg4S04K"
    }
  }
}
